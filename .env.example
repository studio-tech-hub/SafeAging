# SafeAging — Environment Variables
# Copy to .env and fill in real values before running.
#
# NOTE: When running via Docker Compose, DATABASE_URL and S3_ENDPOINT
# are automatically overridden to use Docker-internal service names
# (postgres:5432, minio:9000). The values below are for local/direct runs.

# =============================================================================
# Service runtime
# =============================================================================
SERVICE_HOST=0.0.0.0
SERVICE_PORT=18000
API_KEY_REQUIRED=true
API_KEY=change-me-to-a-strong-secret

REQUIRE_HTTPS=false
LOG_FORMAT=json

# Rate limiter — plugin on Windows host → Docker sees gateway IP, not loopback.
# Defaults in config.py: 1200/camera and 2400/IP per 60s window (~20 req/s total headroom).
RATE_LIMIT_MAX_PER_CAMERA=1200
RATE_LIMIT_MAX_PER_IP=2400

# =============================================================================
# Model & inference (pass-1 edge tuning — dev PC + AI Box 6490 baseline)
# =============================================================================
# Path inside the container (or absolute path for local run)
# Recommended CPU production on AI Box: yolo26n.onnx @ 640 + buffalo_s.
# Do not use yolo26s on CPU; it is only for a future accelerator/NPU path.
MODEL_PATH=/app/models/yolo26n.onnx
# Export: python tools/export_yolo26_onnx.py --model models/yolo26n.pt --out models/yolo26n.onnx

# YOLO inference backend (QCS6490: Qualcomm QNN, not NVIDIA CUDA)
# cpu      — ONNX Runtime CPU (default)
# qnn_htp  — Hexagon NPU (fastest when QAIRT + onnxruntime-qnn installed)
# qnn_gpu  — Adreno GPU (needs libQnnGpu.so)
# qnn      — alias for qnn_htp
YOLO_BACKEND=cpu
# QNN_BACKEND_PATH=/opt/qairt/lib/aarch64-android/libQnnHtp.so
# QNN_HTP_PERFORMANCE_MODE=burst
# QNN_HTP_FP16=true

# Minimum square inference input (px) for YOLO + face detection. Do not set below 640.
MIN_INPUT_RESOLUTION=640

# YOLO input size (square). Minimum 640 — enforced in config.py even if set lower.
YOLO_IMGSZ=640

# Parallel /infer workers (Docker only). 4 cameras @ ~5–8 fps each → try 4; needs ~6 GB RAM.
UVICORN_WORKERS=1

# Face (InsightFace) — biggest CPU cost after YOLO on multi-camera boxes
ENABLE_FACE_RECOGNITION=true
FACE_RECOG_INTERVAL_FRAMES=24
# insightface SCRFD detector input (square). Minimum 640 — enforced in config.py.
FACE_DET_SIZE=640
# Min person-crop side (px) before attempting face recognition.
FACE_MIN_PIXELS=40
# Cosine match threshold (0.35–0.50 typical). Lower = easier match, more false IDs.
FACE_MATCH_THRESHOLD=0.42

# Upscale short side to MIN_INPUT_RESOLUTION before YOLO (maps boxes back for plugin).
ENABLE_INPUT_UPSCALE=true

# Fall detection (heuristic on bbox + multi-frame confirm).
FALL_CONFIRM_FRAMES=3
FALL_VELOCITY_REF_HEIGHT=120
FALL_VELOCITY_THRESHOLD=22
FALL_ASPECT_RATIO_THRESHOLD=1.6

# Detection / tracking (Phase 1 tuning).
CONFIDENCE_THRESHOLD=0.70
TRACK_MIN_HITS=2
OUTPUT_TENTATIVE_TRACKS=false
FACE_MODEL_PACK=buffalo_s

# Phase 2 — optional YOLO-pose for fall (off by default; +~100–200ms when on).
ENABLE_POSE_FALL=false
POSE_MODEL_PATH=yolo11n-pose.pt
POSE_IMGSZ=640
POSE_INTERVAL_FRAMES=6
POSE_TORSO_ANGLE_THRESHOLD=55
ENABLE_UNDISTORT=false
ENABLE_ROI=true
ENABLE_MULTI_SCALE=false

# =============================================================================
# Central PostgreSQL
# =============================================================================
POSTGRES_DB=safeaging
POSTGRES_USER=safeaging
POSTGRES_PASSWORD=safeaging_dev_password
POSTGRES_PORT=15432

# Used for local/direct runs. Docker Compose overrides this automatically.
DATABASE_URL=postgresql://safeaging:safeaging_dev_password@localhost:15432/safeaging

# =============================================================================
# Edge local persistence
# =============================================================================
# Docker Compose sets this to /app/runtime/edge_state.db automatically.
EDGE_SQLITE_PATH=runtime/edge_state.db

# =============================================================================
# MinIO / object storage
# =============================================================================
MINIO_ROOT_USER=safeaging
MINIO_ROOT_PASSWORD=safeaging_minio_password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET_SNAPSHOTS=safeaging-snapshots

# Used for local/direct runs. Docker Compose overrides this automatically.
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=safeaging
S3_SECRET_KEY=safeaging_minio_password
S3_BUCKET_SNAPSHOTS=safeaging-snapshots
S3_REGION=us-east-1
S3_SECURE=false

# =============================================================================
# Alert / email (S P1.3 + S P2.3) — leave blank to disable
# =============================================================================
# SMTP server (e.g. smtp.gmail.com, smtp.mailersend.net)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@safeaging.local
# Recipient for fall-detection and zone-violation alerts
ALERT_EMAIL_TO=
ALERT_FALL_ENABLED=true

# S P2.3 — Alert engine tuning
ALERT_ZONE_VIOLATION_ENABLED=true
# Suppress duplicate alerts for same camera+track+type within N seconds
ALERT_DEDUPE_SEC=60
# Max alert retries on SMTP failure (exponential backoff: 1s, 2s, 4s, ...)
ALERT_MAX_RETRIES=3
# Max alerts sent per camera per sliding window (prevents alert storms)
ALERT_RATE_LIMIT_MAX=10
ALERT_RATE_LIMIT_WINDOW_SEC=600

# S P2.4 — Retention policy
# Hard-delete events/alerts older than this many days (0 = disabled)
RETENTION_DAYS=30
# How often to run the cleanup check (in hours)
RETENTION_CHECK_HOURS=6

# S P2.1 — Person ReID
# Cosine similarity threshold for person matching (0.0–1.0; higher = stricter)
REID_MATCH_THRESHOLD=0.65
# Automatically link fall/zone_violation events to persons via ReID (in outbox worker)
REID_AUTO_LINK_ENABLED=true

# =============================================================================
# Monitoring
# =============================================================================
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
