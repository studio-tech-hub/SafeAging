# SafeAging — Environment Variables
# Copy to .env and fill in real values before running.
#
# NOTE: When running via Docker Compose, DATABASE_URL and S3_ENDPOINT
# are automatically overridden to use Docker-internal service names
# (postgres:5432, minio:9000). The values below are for local/direct runs.

# =============================================================================
# Service runtime
# =============================================================================
SERVICE_HOST=0.0.0.0
SERVICE_PORT=18000

# REQUIRED (P0-2): the service refuses to start if API_KEY_REQUIRED=true and
# API_KEY is empty or a known placeholder (e.g. "change-me-to-a-strong-secret"
# below is a placeholder — replace it). Generate a real key with:
#   python tools/generate_api_key.py           (API_KEY only)
#   python tools/generate_secrets.py           (P0-3: this + every other
#                                                required secret, in one shot)
# For an AI Box / Nx plugin deployment, set the SAME value as the "Service API
# Key" setting on every camera in Nx Client before deploying, or the plugin
# will get HTTP 401 and cameras will stop showing detections.
API_KEY_REQUIRED=true
API_KEY=change-me-to-a-strong-secret
# Optional (P0-4): set API_KEY_FILE=/path/to/secret instead of the inline
# value above to read the key from a mounted file (Docker/Kubernetes secrets
# convention) — takes precedence over API_KEY if both are set. Same pattern
# is available for DATABASE_URL, S3_ACCESS_KEY, S3_SECRET_KEY, and
# SMTP_PASSWORD below (as `<VAR>_FILE`). Purely additive — leave unset to
# keep using the plain env vars exactly as before.

# Explicit, opt-in-only escape hatch to run without authentication. Default
# false. Only ever set true on a fully isolated/trusted lab network — never on
# a shared network or anything internet-reachable.
ALLOW_INSECURE_NO_AUTH=false

REQUIRE_HTTPS=false
LOG_FORMAT=json

# Rate limiter — plugin on Windows host → Docker sees gateway IP, not loopback.
# Defaults in config.py: 1200/camera and 2400/IP per 60s window (~20 req/s total headroom).
RATE_LIMIT_MAX_PER_CAMERA=1200
RATE_LIMIT_MAX_PER_IP=2400

# =============================================================================
# Model & inference (pass-1 edge tuning — dev PC + AI Box 6490 baseline)
# =============================================================================
# Path inside the container (or absolute path for local run)
# Recommended CPU production on AI Box: yolo26n.onnx @ 640 + buffalo_s.
# Do not use yolo26s on CPU; it is only for a future accelerator/NPU path.
MODEL_PATH=/app/models/yolo26n.onnx
# Export: python tools/export_yolo26_onnx.py --model models/yolo26n.pt --out models/yolo26n.onnx

# YOLO inference backend (QCS6490: Qualcomm QNN, not NVIDIA CUDA)
# cpu      — Ultralytics-managed, single shared ORT session. Simplest option;
#            fine for a single camera / local dev, but every concurrent
#            camera stream fights over that one session's intra-op thread
#            pool (+ torch OMP threads), so throughput degrades as camera
#            count grows.
# cpu_lean — RECOMMENDED DEFAULT for any deployment with 2+ cameras (this is
#            what docker-compose.aibox-hostdb.yml — the AI Box production
#            profile — already uses). A small pool of dedicated ORT sessions
#            with pinned intra-op threads (see YOLO_LEAN_POOL_SIZE /
#            YOLO_LEAN_THREADS below) removes the session contention above
#            and runs the same model ~3-4x faster under 3+ concurrent camera
#            streams, with identical detection output (P1-3 fixed the one
#            correctness bug specific to this path — the greedy-NMS box
#            format — so it is now on par with `cpu` for accuracy, not just
#            speed). Needs the model .onnx exported at >=640px.
# qnn_htp  — Hexagon NPU (fastest when QAIRT + onnxruntime-qnn installed).
#            Opt-in only — see "QNN Promotion Checklist" in
#            working_pipeline/QNN_ROADMAP.md before recommending this as a
#            production default for a given SoC/firmware combination.
# qnn_gpu  — Adreno GPU (needs libQnnGpu.so). Same promotion gate as qnn_htp.
# qnn      — alias for qnn_htp
YOLO_BACKEND=cpu_lean
# Only used when YOLO_BACKEND=cpu_lean. Defaults below match the AI Box
# production profile (docker-compose.aibox-hostdb.yml): 2 sessions x 2
# threads each = ~4 cores, leaving headroom for the Nx mediaserver/OS on a
# QCS6490. Do not raise YOLO_LEAN_POOL_SIZE above 2 with 3+ cameras unless
# you've verified host CPU load stays under ~80% (see "Do NOT on CPU" in
# working_pipeline/CPU_PRODUCTION_PROFILE.md).
YOLO_LEAN_POOL_SIZE=2
YOLO_LEAN_THREADS=2
# QCS6490 / Hexagon V68 QNN overlay values.
# Leave YOLO_BACKEND=cpu_lean until the "QNN Promotion Checklist" in
# working_pipeline/QNN_ROADMAP.md passes for this exact SoC/firmware, including
# `qnn-platform-validator --backend dsp --testBackend`.
# QNN_BACKEND_PATH=
# PRODUCT_SOC=6490
# DSP_ARCH=68
# QNN_HTP_ARCH=68
# QNN_SOC_MODEL=35
# QNN_HTP_PERFORMANCE_MODE=burst
# QNN_HTP_FP16=true

# P1-3: coordinate space of end2end (NMS-embedded) ONNX box outputs.
# auto (default) — infer per-detection from frame-bound overflow (safe fallback
#   for already-exported models with no recorded contract).
# canvas — force letterbox-canvas rescaling (use once an export is confirmed
#   to always emit canvas-space coordinates).
# frame — force original-frame passthrough, no rescale.
# END2END_COORD_SPACE=auto

# Minimum square inference input (px) for YOLO + face detection. Do not set below 640.
MIN_INPUT_RESOLUTION=640

# YOLO input size (square). Minimum 640 — enforced in config.py even if set lower.
YOLO_IMGSZ=640

# Parallel /infer workers (Docker only). 4 cameras @ ~5–8 fps each → try 4; needs ~6 GB RAM.
UVICORN_WORKERS=1

# Face (InsightFace) — biggest CPU cost after YOLO on multi-camera boxes
ENABLE_FACE_RECOGNITION=true
FACE_RECOG_INTERVAL_FRAMES=24
# insightface SCRFD detector input (square). Minimum 640 — enforced in config.py.
FACE_DET_SIZE=640
# Min person-crop side (px) before attempting face recognition.
FACE_MIN_PIXELS=40
# Cosine match threshold (0.35–0.50 typical). Lower = easier match, more false IDs.
FACE_MATCH_THRESHOLD=0.42

# Upscale short side to MIN_INPUT_RESOLUTION before YOLO (maps boxes back for plugin).
ENABLE_INPUT_UPSCALE=true

# Fall detection (heuristic on bbox + multi-frame confirm).
FALL_CONFIRM_FRAMES=3
FALL_VELOCITY_REF_HEIGHT=120
FALL_VELOCITY_THRESHOLD=22
FALL_ASPECT_RATIO_THRESHOLD=1.6

# Detection / tracking (Phase 1 tuning).
# P1-2: recommended default lowered to 0.55 (recall vs. precision tradeoff — a
# nano model at 640px missing small/far people or fallen postures is worse for
# a safety product than an occasional extra low-confidence box, which
# TRACK_MIN_HITS/NMS/dedupe already filter out before it becomes a stable
# output). Existing deployments with this already set keep their own value;
# this only changes what *new* deployments start from.
CONFIDENCE_THRESHOLD=0.55
TRACK_MIN_HITS=2
OUTPUT_TENTATIVE_TRACKS=false
FACE_MODEL_PACK=buffalo_s

# Phase 2 — optional YOLO-pose for fall (off by default; +~100–200ms when on).
ENABLE_POSE_FALL=false
POSE_MODEL_PATH=yolo11n-pose.pt
POSE_IMGSZ=640
POSE_INTERVAL_FRAMES=6
POSE_TORSO_ANGLE_THRESHOLD=55
ENABLE_UNDISTORT=false
ENABLE_ROI=true
ENABLE_MULTI_SCALE=false

# =============================================================================
# Central PostgreSQL
# =============================================================================
POSTGRES_DB=safeaging
POSTGRES_USER=safeaging
# REQUIRED (P0-3): compose refuses to start Postgres with this empty or a
# known placeholder. Generate all required secrets in one shot with:
#   python tools/generate_secrets.py
# or manually: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_PORT=15432

# Used for local/direct (non-Docker) runs only — Docker Compose builds this
# automatically from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
# If you run the service directly on the host, keep the password below in
# sync with POSTGRES_PASSWORD.
# P0-4: DATABASE_URL_FILE=/path/to/file also accepted (see API_KEY_FILE note above).
DATABASE_URL=postgresql://safeaging:REPLACE_WITH_POSTGRES_PASSWORD@localhost:15432/safeaging

# =============================================================================
# Edge local persistence
# =============================================================================
# Docker Compose sets this to /app/runtime/edge_state.db automatically.
EDGE_SQLITE_PATH=runtime/edge_state.db

# =============================================================================
# MinIO / object storage
# =============================================================================
MINIO_ROOT_USER=safeaging
# REQUIRED (P0-3): compose refuses to start MinIO with this empty or a known
# placeholder — this is the root credential for all snapshot/crop storage.
# Generate all required secrets in one shot with:
#   python tools/generate_secrets.py
# or manually: openssl rand -base64 24
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET_SNAPSHOTS=safeaging-snapshots

# Used for local/direct runs. Docker Compose overrides S3_ENDPOINT
# automatically. S3_ACCESS_KEY/S3_SECRET_KEY are how the analytics service
# authenticates to MinIO as the root user — MUST match MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD above (tools/generate_secrets.py keeps these in sync).
# P0-4: S3_ACCESS_KEY_FILE / S3_SECRET_KEY_FILE also accepted.
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=safeaging
S3_SECRET_KEY=
S3_BUCKET_SNAPSHOTS=safeaging-snapshots
S3_REGION=us-east-1
S3_SECURE=false

# =============================================================================
# Alert / email (S P1.3 + S P2.3) — leave blank to disable
# =============================================================================
# SMTP server (e.g. smtp.gmail.com, smtp.mailersend.net)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# P0-4: SMTP_PASSWORD_FILE also accepted (see API_KEY_FILE note near the top).
SMTP_PASSWORD=
SMTP_FROM=alerts@safeaging.local
# Recipient for fall-detection and zone-violation alerts
ALERT_EMAIL_TO=
ALERT_FALL_ENABLED=true

# S P2.3 — Alert engine tuning
ALERT_ZONE_VIOLATION_ENABLED=true
# Suppress duplicate alerts for same camera+track+type within N seconds
ALERT_DEDUPE_SEC=60
# Max alert retries on SMTP failure (exponential backoff: 1s, 2s, 4s, ...)
ALERT_MAX_RETRIES=3
# Max alerts sent per camera per sliding window (prevents alert storms)
ALERT_RATE_LIMIT_MAX=10
ALERT_RATE_LIMIT_WINDOW_SEC=600

# S P2.4 — Retention policy
# Hard-delete events/alerts older than this many days (0 = disabled)
RETENTION_DAYS=30
# How often to run the cleanup check (in hours)
RETENTION_CHECK_HOURS=6

# S P2.1 — Person ReID
# Cosine similarity threshold for person matching (0.0–1.0; higher = stricter)
REID_MATCH_THRESHOLD=0.65
# Automatically link fall/zone_violation events to persons via ReID (in outbox worker)
REID_AUTO_LINK_ENABLED=true

# =============================================================================
# Monitoring
# =============================================================================
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
# REQUIRED (P0-3): compose refuses to start Grafana with this empty or a
# known placeholder ("admin" is one of the most commonly scanned-for
# credentials on the internet). Generate all required secrets in one shot:
#   python tools/generate_secrets.py
GRAFANA_ADMIN_PASSWORD=
