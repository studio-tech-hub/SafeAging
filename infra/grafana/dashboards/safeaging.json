{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "SafeAging Analytics Service — realtime monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["safeaging"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SafeAging",
  "uid": "safeaging-v2",
  "version": 2,

  "panels": [

    {
      "id": 100,
      "title": "ROW: Service Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 1,
      "title": "Dependencies",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "safeaging_db_up", "legendFormat": "PostgreSQL", "refId": "A" },
        { "expr": "safeaging_object_storage_up", "legendFormat": "MinIO", "refId": "B" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 4,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds{job=\"safeaging-analytics\"}",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 5,
      "title": "Active Tracks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(safeaging_active_tracks)",
          "legendFormat": "Total active tracks",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 6,
      "title": "Outbox Queue Depth",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "safeaging_outbox_pending", "legendFormat": "Outbox pending", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 7,
      "title": "Pending Alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "safeaging_outbox_errors_total", "legendFormat": "Outbox errors (total)", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 8,
      "title": "ReID Auto-Links",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "teal" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "safeaging_reid_auto_links_total", "legendFormat": "Auto-linked events", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 200,
      "title": "ROW: Inference Performance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 2,
      "title": "Infer Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(safeaging_infer_requests_total{status=\"success\"}[1m])",
          "legendFormat": "OK {{camera_id}}",
          "refId": "A"
        },
        {
          "expr": "rate(safeaging_infer_requests_total{status=\"error\"}[1m])",
          "legendFormat": "ERR {{camera_id}}",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 3,
      "title": "Infer Latency p50 / p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(safeaging_infer_latency_seconds_bucket[2m])) * 1000",
          "legendFormat": "p50 {{camera_id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(safeaging_infer_latency_seconds_bucket[2m])) * 1000",
          "legendFormat": "p95 {{camera_id}}",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 300,
      "title": "ROW: Safety Events",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },

    {
      "id": 9,
      "title": "Safety Events Persisted / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 15 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(safeaging_events_persisted_total{event_type=\"fall\"}[1m]) * 60",
          "legendFormat": "fall {{camera_id}}",
          "refId": "A"
        },
        {
          "expr": "rate(safeaging_events_persisted_total{event_type=\"zone_violation\"}[1m]) * 60",
          "legendFormat": "zone_violation {{camera_id}}",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 10,
      "title": "Events Persisted (total by type)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (event_type) (safeaging_events_persisted_total)",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 400,
      "title": "ROW: Detections & Tracks",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },

    {
      "id": 11,
      "title": "Detections per Frame",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(safeaging_detections_per_frame_bucket[2m]))",
          "legendFormat": "p50 {{camera_id}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 12,
      "title": "Active Tracks per Camera",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "safeaging_active_tracks",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 500,
      "title": "ROW: Outbox & Alerts",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },

    {
      "id": 13,
      "title": "Outbox Throughput",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 32 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(safeaging_outbox_processed_total[1m]) * 60",
          "legendFormat": "processed/min",
          "refId": "A"
        },
        {
          "expr": "rate(safeaging_outbox_dropped_total[1m]) * 60",
          "legendFormat": "dropped/min",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },

    {
      "id": 14,
      "title": "Outbox Errors by Kind",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 32 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(safeaging_outbox_errors_total[5m]) * 60",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }

  ]
}
