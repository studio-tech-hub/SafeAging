{
    "id": "mycompany.yolov8_people_analytics",
    "name": "YOLOv8 People Analytics",
    "description": "Analytics plugin using YOLOv8 model for people detection and tracking.",
    "version": "1.0.0",
    "vendor": "HumanCounterV8",
    "engineSettingsModel": {
        "type": "Settings",
        "items": []
    },
    "deviceAgentSettingsModel": {
        "type": "Settings",
        "items": [
            {
                "type": "Switch",
                "name": "enabled",
                "caption": "Enable Detection",
                "defaultValue": true
            },
            {
                "type": "Number",
                "name": "detection_frame_period",
                "caption": "Detection Frame Period",
                "defaultValue": 2,
                "description": "Run detection every Nth frame."
            },
            {
                "type": "Number",
                "name": "target_enqueue_fps",
                "caption": "Target Enqueue FPS",
                "defaultValue": 8,
                "description": "Max frame enqueue rate to AI worker."
            },
            {
                "type": "Number",
                "name": "frame_queue_max_size",
                "caption": "Frame Queue Max Size",
                "defaultValue": 3,
                "description": "Max buffered frames before dropping oldest."
            },
            {
                "type": "Number",
                "name": "metrics_log_period_sec",
                "caption": "Metrics Period (sec)",
                "defaultValue": 10,
                "description": "Periodic pipeline metrics interval."
            }
        ]
    },
    "capabilities": [
        "needUncompressedVideoFrames_yuv420"
    ],
    "supportedObjectTypes": [
        {
            "id": "mycompany.yolov8_people_analytics.person",
            "name": "Person"
        },
        {
            "id": "mycompany.yolov8_people_analytics.cat",
            "name": "Cat"
        },
        {
            "id": "mycompany.yolov8_people_analytics.dog",
            "name": "Dog"
        }
    ],
    "supportedEventTypes": [
        {
            "id": "mycompany.yolov8_people_analytics.detection",
            "name": "Object detected"
        },
        {
            "id": "mycompany.yolov8_people_analytics.prolongedDetection",
            "name": "Object detected (prolonged)",
            "flags": "stateDependent"
        },
        {
            "id": "mycompany.yolov8_people_analytics.fallDetected",
            "name": "Fall detected",
            "flags": "stateDependent"
        }
    ]
}

