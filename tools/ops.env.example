# AI Box ops credentials for tools/_ssh_*.py scripts.
#
# Copy this file to tools/ops.env and fill in real values:
#   cp tools/ops.env.example tools/ops.env      (or `copy` on Windows)
#
# tools/ops.env is gitignored — it is never committed. Do NOT put real
# credentials in this .example file.
#
# These variables are for internal ops tooling only (deploy/diagnostic
# scripts run by engineers against a physical AI Box). They are unrelated to
# the product's own runtime configuration (see .env.example at repo root).

# Required — AI Box network address.
AIBOX_HOST=192.168.1.210

# Required — SSH username.
AIBOX_USER=root

# Required (choose ONE authentication method):
# Option A: password auth
AIBOX_PASSWORD=

# Option B: key-based auth (preferred — comment out AIBOX_PASSWORD above if used)
# AIBOX_SSH_KEY_PATH=C:/Users/you/.ssh/id_ed25519

# Optional — remote repo checkout path on the box (default: /root/SafeAging).
AIBOX_REMOTE_DIR=/root/SafeAging

# Optional — Nx metadata SDK path on the box, required only by scripts that
# rebuild the C++ plugin (tools/_ssh_deploy_plugin.py, _ssh_deploy_threshold_ui.py,
# _ssh_deploy_metrics_fmt.py).
AIBOX_SDK_DIR=/root/metavms-metadata_sdk-6.0.6.41837-universal/metadata_sdk

# Optional — analytics service API key, only needed by diagnostic scripts that
# call authenticated endpoints (e.g. tools/_ssh_check_face.py). Should match
# the API_KEY configured on the box, not a hardcoded default.
AIBOX_API_KEY=

# Optional — set to 1 to disable SSH host-key verification (paramiko
# AutoAddPolicy instead of RejectPolicy). Lab/disposable boxes ONLY — this is
# vulnerable to MITM and prints a loud warning when used. Prefer trusting the
# host once via `ssh-keyscan -H <host> >> ~/.ssh/known_hosts` instead.
# AIBOX_SSH_INSECURE=0
